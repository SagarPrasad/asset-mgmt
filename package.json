    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^35.0.0",
    "gh-pages": "^6.3.0",
    "vite": "^6.2.0",
    "wait-on": "^8.0.2"
  }
}
