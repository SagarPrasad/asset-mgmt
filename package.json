{
  "name": "family-asset-vault",
  "version": "1.0.0",
  "private": true,
  "description": "Family Asset & Wealth Management System with Supabase, FY Tracking, and ITR Schedule AL Compliance",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "predeploy": "npm run build",
